# ==============================================================================
# SilentSOS Standalone Application Environment Configuration (.env.example)
# Copy this file to backend/.env (and frontend/.env if running frontend separately)
# ==============================================================================

# --- Application Server Configuration ---
PORT=3001
NODE_ENV=production
FRONTEND_URL=http://localhost:3001
APP_URL=http://localhost:3001

# --- PostgreSQL Database Configuration ---
# Supports either direct PostgreSQL connection string (local or hosted, e.g. Neon, Supabase, RDS)
# Example Neon Serverless pooled connection:
DATABASE_URL=postgresql://username:password@ep-sample-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Or local PostgreSQL instance:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/silentsos

# --- Cryptography & Session Security ---
# Secure random string used to sign HMAC-SHA256 JWT tokens:
JWT_SECRET=change_this_to_a_secure_random_secret_in_production
JWT_EXPIRES_IN=604800

# 32-byte secure key used for AES-256-CBC encryption of sensitive emergency contact PII:
ENCRYPTION_SECRET=change_this_to_a_secure_encryption_secret_in_production

# --- Emergency Email Gateway (Nodemailer SMTP) ---
# When configured, dispatches automated emergency alert and cancellation emails with GPS links and evidence
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# --- Alternative Email Service: Resend (Optional) ---
# RESEND_API_KEY=re_1234567890abcdef
# RESEND_SENDER=onboarding@resend.dev

# --- Emergency SMS Gateway: Fast2SMS (Optional) ---
# Real-time bulk SMS dispatch to emergency contacts in India:
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# --- Frontend Google Maps Integration ---
# Google Maps JavaScript API Key (required for satellite map tracking & direction navigation):
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
