# Port for backend server
PORT=3001
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:3001

# Neon PostgreSQL Database Configuration (Pooled Serverless Connection String)
DATABASE_URL=postgresql://username:password@ep-sample-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# JWT Cryptographic Authentication Configuration
JWT_SECRET=your_secure_random_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=604800

# Encryption Secret for Contact PII
ENCRYPTION_SECRET=your_aes_encryption_secret_key_change_in_production

# SMTP Email Configuration (Gmail / Outlook / Custom SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# Optional: Resend API Key for Email Delivery
# RESEND_API_KEY=re_123456789
# RESEND_SENDER=onboarding@resend.dev

# Fast2SMS Gateway Configuration (Optional India SMS Gateway)
FAST2SMS_API_KEY=your_fast2sms_api_key
