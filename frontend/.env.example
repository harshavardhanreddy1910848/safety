# SilentSOS Frontend Configuration (.env.example)

# Backend API base URL.
# In development with Vite proxy, leave empty or set to http://localhost:3001.
# In standalone production (served by backend), leave empty to use same-origin.
VITE_API_BASE=http://localhost:3001

# Google Maps JavaScript API Key (required for satellite map tracking & directions)
# Obtain a key from Google Cloud Console with Maps JavaScript API enabled.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
